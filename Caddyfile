{
	admin off
	auto_https off
	persist_config off
}

# Railway terminates TLS at the edge and injects $PORT.
:{$PORT:80} {
	root * /srv
	encode zstd gzip
	file_server

	# Assets are cache-busted with ?v=N (see README), so they can live forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header *.html Cache-Control "public, max-age=300"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
