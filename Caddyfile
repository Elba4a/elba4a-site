{
	admin off
	auto_https off
	persist_config off
}

# Railway terminates TLS at the edge and injects $PORT.
:{$PORT:80} {
	root * /srv
	encode zstd gzip
	file_server

	# Assets are cache-busted with ?v=N (see README), so they can live forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is a page. Matching on `*.html` would miss both real
	# URLs — `/` and `/en/` are served from index.html but don't end in it.
	@pages not path /assets/*
	header @pages Cache-Control "public, max-age=300"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin

		# Railway already 301s http -> https, but that costs a plaintext round
		# trip on every first visit and leaves a cached http entry showing
		# "Not Secure". HSTS makes the browser rewrite http to https itself,
		# before it touches the network.
		#
		# No `includeSubDomains`: it would force https on email.elba4a.com and
		# ledge.elba4a.com, which are not ours to break. No `preload` either —
		# that is effectively one-way.
		Strict-Transport-Security "max-age=31536000"

		-Server
	}
}
